# Copy to .env only if you want to change something.
#
#   cp .env.example .env
#
# Every value here already has a working default in docker-compose.yml, so
# `docker compose up --build` runs with no .env file at all. The stack starts
# with the deterministic stub reviewer; add a real OPENAI_API_KEY below to
# switch to the live model.

# --- Review provider -------------------------------------------------------
# auto   (default) use OpenAI if OPENAI_API_KEY is set, otherwise the stub
# openai            force OpenAI; fails at startup if no key is set
# stub              force the deterministic offline reviewer
LLM_PROVIDER=auto

# Leave blank to run entirely offline on the stub reviewer.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Database --------------------------------------------------------------
# Used by docker-compose to provision Postgres AND to build DATABASE_URL.
# Change them here only; nothing is duplicated in docker-compose.yml.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=copilot

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
