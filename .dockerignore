# Secrets — must never enter an image layer.
.env
.env.*
!.env.example

# Version control
.git
.gitignore
.github

# Python bytecode & caches
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtualenvs
.venv/
venv/

# Local tooling / editor state
.vscode/
.idea/
*.swp
.DS_Store

# Docs & compose files aren't needed at runtime
docs/
docker-compose*.yml
